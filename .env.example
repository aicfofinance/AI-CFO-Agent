# =============================================================================
# AI CFO Agent — environment variables
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored and must never be committed. Never put real credentials here.
# =============================================================================

# --- Day-one required ---
# Supabase pooler connection (port 6543) — used by the application at runtime.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
# Supabase direct connection (port 5432) — used only for migrations.
DATABASE_URL_DIRECT=postgresql://user:password@host:5432/postgres
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Same URL and anon key exposed to the browser bundle (NEXT_PUBLIC_ prefix required).
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# AES-256-GCM key for OAuth token encryption. Generate with: openssl rand -hex 32
OAUTH_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
# Canonical app URL (server + client). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- QuickBooks (optional until Phase 4) ---
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_ENVIRONMENT=sandbox

# --- Xero (optional until Phase 12) ---
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# --- AI providers (optional — set one) ---
AI_PROVIDER=google
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# --- Inngest (optional until Step 1.7) ---
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# --- Stripe (optional until Phase 13) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Upstash Redis (optional until Step 11.3) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Resend (optional until Phase 2) ---
RESEND_API_KEY=
FROM_EMAIL=
